# The stack's database setup script is embedded with `include_str!` and must stay byte-identical
# to the Python copy (LF) on every checkout, including Windows `core.autocrlf`.
*.sql text eol=lf

# Artifact provenance hashes these inputs byte for byte across Windows and Unix jobs.
Cargo.lock text eol=lf
rust-toolchain.toml text eol=lf
