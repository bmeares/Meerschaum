                "timescaledb": true,
                "timescaledb-ha": true,
                "mssql": true
              },
              "instance": {
                "create_metadata_cache_minutes": 14400,
                "stale_temporary_tables_minutes": 1440,
                "temporary_target": {
                  "prefix": "_",
