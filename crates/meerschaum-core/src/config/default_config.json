        "gold3",
        "pale_green1",
        "light coral",
        "light_goldenrod2",
        "cornsilk1",
        "orange_red1",
        "deep_pink1",
        "aquamarine3",
        "sky_blue2",
        "tan",
        "honeydew2"
      ]
    }
  },
  "stack": {
    "project_name": "mrsm",
    "docker-compose.yaml": {
      "services": {
        "db": {
          "environment": {
            "TIMESCALEDB_TELEMETRY": "off",
            "POSTGRES_USER": "<DOLLAR>POSTGRES_USER",
            "POSTGRES_DB": "<DOLLAR>POSTGRES_DB",
            "POSTGRES_PASSWORD": "<DOLLAR>POSTGRES_PASSWORD",
            "ALLOW_IP_RANGE": "0.0.0.0/0"
          },
          "command": "postgres -c max_connections=1000 -c shared_buffers=1024MB -c max_prepared_transactions=100",
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "pg_isready -h 127.0.0.1 -p 5432 -d <DOLLAR>POSTGRES_DB -U <DOLLAR>POSTGRES_USER"
            ],
            "interval": "5s",
            "timeout": "3s",
            "retries": 5,
            "start_period": "300s"
          },
          "restart": "always",
          "image": "timescale/timescaledb-ha:pg18",
          "ports": [
            "MRSM{meerschaum:connectors:sql:main:port}:5432"
          ],
          "hostname": "db",
          "volumes": [
            "meerschaum_db_data:/home/postgres/pgdata",
            "{__MRSM_ROOT_DIR__}/db/initdb/create-extensions.sql:/docker-entrypoint-initdb.d/100_meerschaum.sql:z,ro"
          ],
          "shm_size": "1024m",
          "networks": [
            "backend"
          ]
        },
        "api": {
          "image": "bmeares/meerschaum:{__MRSM_VERSION__}-full",
          "ports": [
            "MRSM{meerschaum:connectors:api:main:port}:MRSM{meerschaum:connectors:api:main:port}"
          ],
          "hostname": "api",
          "networks": [
            "frontend",
            "backend"
          ],
          "command": "start api --production --port MRSM{meerschaum:connectors:api:main:port}",
          "healthcheck": {
            "test": [
              "CMD",
              "curl",
              "--fail",
              "http://localhost:MRSM{meerschaum:connectors:api:main:port}/healthcheck"
            ],
            "interval": "5s",
            "timeout": "3s",
            "retries": 3
          },
          "environment": {
            "MRSM_CONFIG": "{\n    \"meerschaum\": MRSM{!meerschaum},\n    \"system\": MRSM{!system},\n    \"api\": MRSM{!api}\n}",
            "MRSM_PATCH": "{\n    \"meerschaum\": {\n        \"connectors\": {\n            \"sql\": {\n                \"main\": {\n                    \"host\": \"MRSM{stack:docker-compose.yaml:services:db:hostname}\",\n                    \"port\": 5432\n                },\n                \"local\": {\n                    \"database\": \"/meerschaum/sqlite/mrsm_local.db\"\n                }\n            },\n            \"valkey\": {\n                \"main\": {\n                    \"host\": \"MRSM{stack:docker-compose.yaml:services:valkey:hostname}\",\n                    \"port\": 6379\n                }\n            }\n        }\n    }\n}"
          },
          "restart": "always",
          "init": true,
          "depends_on": {
            "db": {
              "condition": "service_healthy"
            },
            "valkey": {
              "condition": "service_healthy"
            }
          },
          "volumes": [
            "api_root:/meerschaum"
          ]
        },
        "valkey": {
          "image": "valkey/valkey-bundle:latest",
          "restart": "always",
          "environment": {
            "VALKEY_PASSWORD": "<DOLLAR>VALKEY_PASSWORD",
            "VALKEY_RDB_POLICY_DISABLED": "no",
            "VALKEY_RDB_POLICY": "900#1 600#5 300#10 120#50 60#1000 30#10000"
          },
          "hostname": "valkey",
          "ports": [
            "MRSM{meerschaum:connectors:valkey:main:port}:6379"
          ],
          "volumes": [
            "valkey_data:/data"
          ],
          "healthcheck": {
            "test": [
              "CMD",
              "valkey-cli",
              "ping"
            ],
            "interval": "5s",
            "timeout": "3s",
            "retries": 5
          },
          "networks": [
            "backend"
          ]
        },
        "grafana": {
          "image": "grafana/grafana:latest",
          "ports": [
            "3000:3000"
          ],
          "networks": [
            "frontend",
            "backend"
          ],
          "restart": "always",
          "depends_on": {
            "db": {
              "condition": "service_healthy"
            }
          },
          "volumes": [
            "grafana_storage:/var/lib/grafana",
            "{__MRSM_ROOT_DIR__}/stack/grafana/resources/provisioning/datasources:/etc/grafana/provisioning/datasources:z,ro",
            "{__MRSM_ROOT_DIR__}/stack/grafana/resources/provisioning/dashboards:/etc/grafana/provisioning/dashboards:z,ro"
          ],
          "environment": {
            "GF_SECURITY_ALLOW_EMBEDDING": "true",
            "GF_ANALYTICS_REPORTING_ENABLED": "false",
            "GF_AUTH_ANONYMOUS_ENABLED": "true",
            "GF_AUTH_ANONYMOUS_ORG_NAME": "Main Org.",
            "GF_AUTH_ANONYMOUS_ORG_ROLE": "Viewer",
            "GF_AUTH_ANONYMOUS_HIDE_VERSION": "true"
          }
        }
      },
      "networks": {
        "frontend": null,
        "backend": null
      },
      "volumes": {
        "api_root": null,
        "meerschaum_db_data": null,
        "grafana_storage": null,
        "valkey_data": null
      }
    },
    "grafana": {
      "dashboard": {
        "apiVersion": 1,
        "providers": [
          {
            "name": "Default",
            "folder": "Meerschaum Dashboards",
            "options": {
              "path": "/etc/grafana/provisioning/dashboards"
            }
          }
        ]
      },
      "datasource": {
        "apiVersion": 1,
        "datasources": [
          {
            "name": "Meerschaum Main",
            "uid": "meerschaum-main",
            "type": "postgres",
            "jsonData": {
              "sslmode": "disable",
              "postgresVersion": 1800,
              "timescaledb": true,
              "database": "MRSM{meerschaum:connectors:sql:main:database}"
            },
            "user": "MRSM{meerschaum:connectors:sql:main:username}",
            "secureJsonData": {
              "password": "MRSM{meerschaum:connectors:sql:main:password}"
            },
            "url": "MRSM{stack:docker-compose.yaml:services:db:hostname}:5432",
            "isDefault": true,
            "editable": true
          }
        ]
      }
    },
    "filetype": "yaml"
  },
  "dash": {
    "max_num_pipes_cards": 20
  }
}
