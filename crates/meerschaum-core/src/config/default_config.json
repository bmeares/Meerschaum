  "pipes": {
    "parameters": {
      "columns": {
        "datetime": null
      },
      "fetch": {
        "backtrack_minutes": 1440
      },
      "verify": {
        "bound_days": 366,
        "chunk_minutes": 43200
      }
    },
    "attributes": {
      "local_cache_timeout_seconds": 600.0
    },
    "sync": {
      "filter_params_index_limit": 250,
      "exists_cache_seconds": 60.0
    },
    "verify": {
      "max_chunks_syncs": 3
    },
    "autotime": {
      "column_name_if_datetime_missing": "ts"
    },
    "dtypes": {
      "min_ratio_columns_changed_for_full_astype": 0.5,
      "columns_types_cache_seconds": 60.0
    },
    "static": {
      "static_schema_cache_seconds": 3600.0
    },
    "cache": {
      "enabled": true
    }
  },
  "plugins": {},
  "jobs": {
    "timeout_seconds": 4,
    "check_timeout_interval_seconds": 0.1,
    "terminal": {
      "lines": 40,
      "columns": 70
    },
    "logs": {
      "timestamps": {
        "enabled": true,
        "format": "%Y-%m-%d %H:%M",
        "follow_format": "%H:%M"
      },
      "num_files_to_keep": 5,
      "max_file_size": 100000,
      "lines_to_show": 30,
      "refresh_files_seconds": 5,
      "min_buffer_len": 5,
      "colors": [
        "cyan",
        "magenta",
        "orange3",
        "green",
        "blue",
        "red",
        "spring_green3",
        "medium_purple3",
        "medium_violet_red",
        "slate_blue1",
