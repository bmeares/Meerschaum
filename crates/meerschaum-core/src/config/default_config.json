      "location": "📍",
      "locked": "🔒",
      "unlocked": "🔓",
      "key": "🔑",
      "idea": "💡",
      "connected": "🟢",
      "disconnected": "🔴",
      "running": "🟢",
      "paused": "🟡",
      "stopped": "🔴",
      "tag": "🔖",
      "announcement": "📢"
    },
    "pipes": {
