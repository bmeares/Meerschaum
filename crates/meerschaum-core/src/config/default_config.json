{
  "meerschaum": {
    "instance": "sql:main",
    "api_instance": "MRSM{meerschaum:instance}",
    "repository": "api:mrsm",
    "dataframe": "polars",
    "connectors": {
      "sql": {
        "default": {},
        "main": {
          "username": "mrsm",
          "password": "mrsm",
          "flavor": "timescaledb-ha",
          "host": "localhost",
          "database": "meerschaum",
          "port": 5432
        },
        "local": {
          "flavor": "sqlite",
          "database": "{SQLITE_DB_PATH}"
        },
        "memory": {
          "flavor": "sqlite",
          "database": ":memory:"
        }
      },
      "api": {
        "default": {
          "protocol": "http"
        },
        "main": {
          "host": "localhost",
          "port": 8000
        },
        "local": {
          "host": "localhost",
          "port": 8000
        },
        "mrsm": {
          "host": "api.mrsm.io",
          "port": 443,
          "protocol": "https"
        }
      },
      "valkey": {
        "main": {
          "host": "localhost",
          "username": "default",
          "password": "mrsm",
          "port": 6379
        }
      }
    }
  },
  "system": {
    "connectors": {
      "all": {
        "pandas": "pandas"
      },
      "sql": {
        "bulk_insert": {
          "postgresql": true,
          "postgis": true,
          "citus": true,
          "timescaledb": true,
          "timescaledb-ha": true,
          "mssql": true
        },
        "instance": {
          "create_metadata_cache_minutes": 14400,
          "stale_temporary_tables_minutes": 1440,
          "temporary_target": {
            "prefix": "_",
            "transaction_id_length": 4,
            "separator": "_"
          },
          "max_partitions_per_sync": 10000
        },
        "chunksize": 100000,
        "poolclass": "sqlalchemy.pool.QueuePool",
        "create_engine": {
          "method": "multi",
          "pool_size": 8,
          "max_overflow": 12,
          "pool_recycle": 3600,
          "connect_args": {}
        }
      },
      "api": {}
    },
    "cli": {
      "max_daemons": {
        "__mrsm_dynamic__": "cpu_count*3"
      },
      "refresh_seconds": 0.1,
      "allowed_prefixes": [
        "*"
      ],
      "disallowed_prefixes": [
        "edit",
        "start daemon",
        "start job",
        "stop job",
        "delete job",
        "stop daemon",
        "show daemon",
        "restart daemon",
        "install",
        "upgrade",
        "reload",
        "start worker",
        "show log",
        "python",
        "login",
        "executor",
        "os ",
        "sh ",
        "start api",
        "start webterm",
        "stack",
        "instance",
        "debug",
        "bootstrap",
        "daemon",
        "sql",
        "register plugin",
        "copy "
      ]
    },
    "experimental": {
      "fetch": false,
      "cache": true,
      "space": false,
      "join_fetch": false,
      "inplace_sync": true,
      "uv_pip": true,
      "systemd_healthcheck": false,
      "valkey_session_cache": true,
      "cli_daemon": false
    }
  },
  "api": {
    "uvicorn": {
      "app": "meerschaum.api:app",
      "port": 8000,
      "host": "0.0.0.0",
      "workers": {
        "__mrsm_dynamic__": "max(cpu_count/2,1)"
      },
      "proxy_headers": true,
      "forwarded_allow_ips": "*"
    },
    "cache": {
      "connector": "valkey:main",
      "session_expires_minutes": 43200,
      "pipes": false
    },
    "data": {
      "max_response_row_limit": 100000,
      "chunks": {
        "ttl_seconds": 1800
      }
    },
    "endpoints": {
      "docs_in_production": true
    },
    "mcp": {
      "enabled": true,
      "read_only": false,
      "actions": {
        "denylist": [
          "sh",
          "os",
          "python",
          "stack",
          "sql",
          "install"
        ],
        "allowlist": []
      }
    },
    "dash": {
      "callbacks_require_session": true,
      "mcp": {
        "enabled": false
      }
    },
    "tokens": {
      "valid_refresh_minutes": 60,
      "default_expiration_days": 366
    },
    "permissions": {
      "registration": {
        "users": false,
        "pipes": true,
        "plugins": true
      },
      "chaining": {
        "insecure_parent_instance": false,
        "child_apis": false
      },
      "instances": {
        "allow_multiple_instances": true,
        "allowed_instance_keys": [
          "*"
        ]
      },
      "routes": {
        "allowlist": [
          "*"
        ]
      }
    },
    "protocol": "http",
    "webterm": {
      "tmux": {
        "enabled": true,
        "session_suffix": "_mrsm"
      },
      "host": "127.0.0.1",
      "port": 8765
    }
  },
  "formatting": {
